PORT=5002
MONGO_URI=mongodb://127.0.0.1:27017/biograph
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=biograph123

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=biograph_qdrant_key
QDRANT_COLLECTION=biograph_papers

# Embedding Provider: 'local' (free, CPU), 'openai' (paid), 'hash' (testing)
EMBEDDING_PROVIDER=local

# Local model (used when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# OpenAI (only used when EMBEDDING_PROVIDER=openai)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- PubMed Integration ---
NCBI_TOOL=biograph-research-platform
